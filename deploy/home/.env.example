REGISTRY=ghcr.91856478.xyz:8443
IMAGE_REPOSITORY=lochinemak/wechat-ai
IMAGE_TAG=edge

# Generate with: openssl rand -hex 32
REDIS_PASSWORD=replace-with-a-long-random-password
WECHAT_AI_TOKEN=replace-with-a-long-random-token

PUBLIC_BASE_URL=https://webot.geneyuriy.com
COOKIE_SECURE=true
WORKER_ID=home-01
WORKER_ENABLED=true
OTA_ENABLED=false

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini

# Local account mode. The first registered account becomes administrator.
LOCAL_AUTH_ENABLED=true
LINUXDO_AUTH_ENABLED=false
FIRST_USER_IS_ADMIN=true
LINUXDO_ADMIN_IDS=
